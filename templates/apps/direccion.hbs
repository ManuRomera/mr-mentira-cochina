<div class="mc-panel">
  <nav class="mc-pestanas tabs" role="tablist">
    {{#each pestanas}}<button type="button" role="tab" class="{{#if activa}}active{{/if}}" aria-selected="{{activa}}" data-action="tab" data-group="panel" data-tab="{{id}}"><i class="fa-solid {{icono}}" inert></i> {{nombre}}</button>{{/each}}
  </nav>

  <section data-group="panel" data-tab="mesa" class="tab mc-pestana {{#if (eq pestana "mesa")}}active{{/if}} mc-mesa">
    <div class="mc-recuadro mc-reloj">
      <h3>Reloj real <small>120 minutos de mesa</small></h3>
      <div class="mc-reloj-fila">
        <b class="mc-reloj-num" aria-live="polite">{{reloj.texto}}</b>
        <span class="mc-reloj-tramo">{{reloj.tramo}}</span>
        <span class="mc-reloj-botones">
          <button type="button" class="mc-boton" data-action="reloj" data-op="marcha" data-tooltip="{{#if reloj.marcha}}Pausar{{else}}Poner en marcha{{/if}}"><i class="fa-solid {{#if reloj.marcha}}fa-pause{{else}}fa-play{{/if}}" inert></i></button>
          <button type="button" class="mc-boton mc-boton-suave" data-action="reloj" data-op="menos" data-tooltip="−5 minutos">−5</button>
          <button type="button" class="mc-boton mc-boton-suave" data-action="reloj" data-op="mas" data-tooltip="+5 minutos">+5</button>
          <button type="button" class="mc-boton mc-boton-suave" data-action="reloj" data-op="cero" data-tooltip="Empezar de cero: reloj, marcadores, retos y cortinillas"><i class="fa-solid fa-rotate-left" inert></i></button>
        </span>
      </div>
      <div class="mc-reloj-barra"><i style="width:{{reloj.pct}}%"></i></div>
      {{#if reloj.aviso}}<p class="mc-aviso"><i class="fa-solid fa-bell" inert></i> ¡Toca cortinilla! «{{reloj.aviso}}»</p>{{/if}}
    </div>

    <div class="mc-dos">
      <div class="mc-recuadro mc-medidor">
        <h3>Desbarajuste <small>{{desbarajuste.valor}}/6</small></h3>
        <div class="mc-casillas" role="group" aria-label="Desbarajuste">
          <button type="button" class="mc-boton mc-boton-suave" data-action="marcador" data-clave="desbarajuste" data-delta="-1" aria-label="Bajar">−</button>
          {{#each desbarajuste.casillas}}<button type="button" class="mc-pip {{#if llena}}llena{{/if}}" data-action="marcador" data-clave="desbarajuste" data-valor="{{n}}" aria-label="Nivel {{n}}"></button>{{/each}}
          <button type="button" class="mc-boton mc-boton-suave" data-action="marcador" data-clave="desbarajuste" data-delta="1" aria-label="Subir">+</button>
        </div>
        <p>{{desbarajuste.texto}}</p>
        <p class="mc-nota">Sube solo con un desastre realmente nuevo; baja uno si se dedica una escena a reparar. A 6, si de noche no calman a ME-NT, se activa el Final C.</p>
      </div>
      <div class="mc-recuadro mc-medidor mc-noche">
        <h3>Ruido <small>{{ruido.valor}}/4 · rastreo nocturno</small></h3>
        <div class="mc-casillas" role="group" aria-label="Ruido">
          <button type="button" class="mc-boton mc-boton-suave" data-action="marcador" data-clave="ruido" data-delta="-1" aria-label="Bajar">−</button>
          {{#each ruido.casillas}}<button type="button" class="mc-pip {{#if llena}}llena{{/if}}" data-action="marcador" data-clave="ruido" data-valor="{{n}}" aria-label="Ruido {{n}}"></button>{{/each}}
          <button type="button" class="mc-boton mc-boton-suave" data-action="marcador" data-clave="ruido" data-delta="1" aria-label="Subir">+</button>
        </div>
        <p>{{ruido.texto}}</p>
        <p class="mc-nota">Cada mentira de PJ durante la búsqueda suma una. A 4, pulso doble contra dos PJ.</p>
      </div>
    </div>

    <button type="button" class="mc-piuuum" data-action="piuuum" data-tooltip="Destello y sonido de ME-NT en todas las pantallas"><span>¡PIUUUM!</span><small>alguien ha mentido</small></button>

    <h3 class="mc-rotulo">Cortinillas del Sol y Porco</h3>
    <div class="mc-cortinillas">
      {{#each cortinillas}}
      <button type="button" class="mc-cortinilla {{#if hecha}}hecha{{/if}}" data-action="cortinilla" data-id="{{id}}" data-tooltip="Activa la escena y lee la narración">
        <img src="{{arte}}" alt=""><b>{{titulo}}</b><small>minuto {{minuto}}{{#if hecha}} · hecha{{/if}}</small>
      </button>
      {{/each}}
    </div>
    <p class="mc-nota">Corte obligatorio a los 40 minutos, a los 80 y a los 112. La promesa estructural se cumple siempre: Sol y Porco al amanecer → al mediodía → Luna y Porco de noche → nuevo amanecer.</p>
    <div class="mc-fila-botones">
      <button type="button" class="mc-boton mc-boton-suave" data-action="diario" data-clave="chuleta"><i class="fa-solid fa-note-sticky" inert></i> Chuleta</button>
      <button type="button" class="mc-boton mc-boton-suave" data-action="diario" data-clave="guia"><i class="fa-solid fa-book-open" inert></i> La aventura</button>
      <button type="button" class="mc-boton mc-boton-suave" data-action="seguridad"><i class="fa-solid fa-shield-heart" inert></i> Seguridad</button>
    </div>
  </section>

  <section data-group="panel" data-tab="retos" class="tab mc-pestana {{#if (eq pestana "retos")}}active{{/if}} mc-retos">
    <p class="mc-nota">Elige 6–8 en total. Los de gran escala (R13–R16) se desbloquean con Desbarajuste 3 o más. 1 frase falsa → «¡PIUUUM!» → imagen imposible → algo personal en peligro → «¿qué hacéis?» → resolución abierta → remate → guarda la secuela.</p>
    <div class="mc-chips">{{#each grupos}}<button type="button" class="mc-chip {{#if activo}}activo{{/if}}" data-action="filtro" data-clave="{{clave}}">{{nombre}}</button>{{/each}}</div>
    {{#each retos}}
    <details class="mc-reto {{estado}}" data-memoria="reto-{{id}}">
      <summary><span class="mc-reto-cod">{{id}}</span> <b>{{titulo}}</b> <small>{{quien}} · {{cuando}}</small>{{#if reservado}}<span class="mc-sello" data-tooltip="Se desbloquea con Desbarajuste 3 o más">Desbarajuste 3+</span>{{/if}}{{#if estado}}<span class="mc-sello">{{estado}}</span>{{/if}}</summary>
      <dl>
        <dt>Mentira</dt><dd>{{mentira}}</dd><dt>Urgencia</dt><dd>{{urgencia}}</dd><dt>Opciones</dt><dd>{{opciones}}</dd>
        <dt>Giro</dt><dd>{{giro}}</dd><dt>Secuela</dt><dd>{{secuela}}</dd>
      </dl>
      <div class="mc-fila-botones">
        <button type="button" class="mc-boton" data-action="reto" data-id="{{id}}"><i class="fa-solid fa-satellite-dish" inert></i> ¡A la mesa!</button>
        <button type="button" class="mc-boton mc-boton-suave" data-action="estadoReto" data-id="{{id}}"><i class="fa-solid fa-check" inert></i> {{#if (eq estado "resuelto")}}Reabrir{{else}}Resuelto{{/if}}</button>
      </div>
    </details>
    {{/each}}
  </section>

  <section data-group="panel" data-tab="juicio" class="tab mc-pestana {{#if (eq pestana "juicio")}}active{{/if}} mc-juicio">
    <div class="mc-fila-botones">
      <button type="button" class="mc-boton" data-action="escena" data-clave="13-azotea"><i class="fa-solid fa-building" inert></i> Azotea</button>
      <button type="button" class="mc-boton" data-action="escena" data-clave="14-campanario"><i class="fa-solid fa-bell" inert></i> Campanario</button>
      <button type="button" class="mc-boton" data-action="silencio"><i class="fa-solid fa-moon" inert></i> El silencio de la máquina</button>
      <button type="button" class="mc-boton mc-boton-fuerte" data-action="juicio"><i class="fa-solid fa-gavel" inert></i> ¡Empieza el juicio!</button>
    </div>
    <p class="mc-nota">ME-NT pone en escena el <b>tema</b> de la verdad privada, sin leer el secreto. Cada PJ puede mentir, decir la verdad, callar, cambiar de tema, negociar o actuar. No se tira para sincerarse.</p>
    {{#each provocaciones}}
    <div class="mc-recuadro mc-provocacion">
      {{#if actor}}<img src="{{actor.img}}" alt="" data-retrato="{{actor.id}}">{{else}}<img src="{{../arte}}/personajes/ment-cara.webp" alt="">{{/if}}
      <div><b>{{pj}}</b><blockquote class="mc-globo">{{provocacion}}</blockquote><p class="mc-nota"><b>Si vuelve a mentir:</b> {{si_miente}}</p></div>
      <button type="button" class="mc-boton" data-action="provocar" data-i="{{@index}}" data-tooltip="ME-NT lo dice en el chat"><i class="fa-solid fa-comment" inert></i></button>
    </div>
    {{/each}}
    <h3 class="mc-rotulo">Frases de ME-NT</h3>
    <div class="mc-chips">{{#each frases}}<button type="button" class="mc-chip" data-action="frase" data-i="{{i}}">{{texto}}</button>{{/each}}</div>
    <h3 class="mc-rotulo">Finales <small>se anotan; la tarjeta solo la ves tú</small></h3>
    <div class="mc-finales">
      {{#each finales}}<button type="button" class="mc-final {{#if elegido}}elegido{{/if}}" data-action="final" data-id="{{id}}"><b>{{id}} · {{nombre}}</b><small>{{texto}}</small></button>{{/each}}
    </div>
  </section>

  <section data-group="panel" data-tab="reparto" class="tab mc-pestana {{#if (eq pestana "reparto")}}active{{/if}} mc-reparto">
    <div class="mc-reparto-rejilla">
      {{#each reparto}}
      <button type="button" class="mc-tarjeta-pj" data-action="abrir" data-id="{{id}}">
        <img src="{{img}}" alt="" data-retrato="{{id}}"><b>{{nombre}}</b><small>{{titulo}}</small>
        <span class="mc-ficha-mini {{#if ya}}gastada{{/if}}" data-tooltip="¡Eso ya lo sabía! {{#if ya}}(gastada){{else}}(disponible){{/if}}"><i class="fa-solid fa-lightbulb" inert></i></span>
        <em>{{#if duenos}}{{duenos}}{{else}}sin jugador asignado{{/if}}</em>
      </button>
      {{else}}<p class="mc-nota">No hay personajes jugadores en el mundo.</p>{{/each}}
    </div>
    <div class="mc-fila-botones"><button type="button" class="mc-boton mc-boton-suave" data-action="reponer"><i class="fa-solid fa-rotate-left" inert></i> Reponer todas las fichas «¡Eso ya lo sabía!»</button></div>
    <p class="mc-nota">Para repartir: clic derecho sobre el personaje en el directorio → Configurar propiedad, y que cada jugador lo elija en su configuración de usuario.</p>
    <h3 class="mc-rotulo">Vecinos y cameos</h3>
    <div class="mc-vecinos">{{#each vecinos}}<button type="button" data-action="abrir" data-id="{{id}}" data-tooltip="{{nombre}}"><img src="{{img}}" alt="{{nombre}}" data-retrato="{{id}}"></button>{{/each}}</div>
  </section>
</div>
